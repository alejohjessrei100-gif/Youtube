+def parchment(cv, x, y, w, h, lines, size=30, circle=None, rod=True, seed=0):
+    """A hanging parchment sheet (medieval calendar / notice): wavy edges, wooden rod, ink lettering.
+    lines: text lines spread top to bottom; circle: index of a line to ring in red ink."""
+    from .text import draw_text
+    r = rng(seed)
+    pts = [(x, y)]
+    for k in range(1, 6):
+        pts.append((x + w * k / 6, y + r.uniform(-3, 3)))
+    pts += [(x + w, y), (x + w + r.uniform(-4, 4), y + h * 0.5), (x + w, y + h)]
+    for k in range(5, 0, -1):
+        pts.append((x + w * k / 6, y + h + r.uniform(-7, 7)))
+    pts += [(x, y + h), (x + r.uniform(-4, 4), y + h * 0.5)]
+    sheet = path_poly(pts)
+    cv.drawPath(sheet, fill('#efe2bf'))
+    cv.save(); cv.clipPath(sheet, doAntiAlias=True)
+    cv.drawRect(skia.Rect.MakeXYWH(x, y + h * 0.82, w, h * 0.2), fill('#d8c490', 0.5))
+    cv.drawRect(skia.Rect.MakeXYWH(x + w * 0.9, y, w * 0.12, h), fill('#d8c490', 0.4))
+    cv.restore()
+    cv.drawPath(sheet, ink(SET_INK))
+    n = len(lines)
+    step = (h - size * 1.2) / max(1, n)
+    for k, t in enumerate(lines):
+        by = y + size * 0.9 + step * (k + 0.75)
+        draw_text(cv, t, x + w / 2, by, size, '#3a2a20')
+        if circle == k:
+            cv.drawPath(ellipse(x + w / 2, by - size * 0.36, w * 0.4, size * 0.72), stroke('#c8343c', 4))
