 "sentences": [
  {
   "text": "It's the last match of Zinedine Zidane's career, and he's about to be sent off.",
   "start": 0.0,
   "end": 3.92
  },
  {
   "text": "The 108th minute of a World Cup final.",
   "start": 4.3,
   "end": 6.71
  },
  {
   "text": "He turns around and headbutts Marco Materazzi in the chest.",
   "start": 7.16,
   "end": 10.16
  },
  {
   "text": "Materazzi drops.",
   "start": 10.54,
   "end": 11.62
  },
  {
   "text": "But the referee didn't see it.",
   "start": 12.04,
   "end": 13.32
  },
  {
   "text": "Neither did his assistants.",
   "start": 13.51,
   "end": 14.76
  },
  {
   "text": "So how does a red card happen?",
   "start": 15.12,
   "end": 16.62
  },
  {
   "text": "The referee calls the fourth official on his headset, and he confirms it.",
   "start": 17.1,
   "end": 20.2
  },
  {
   "text": "Red card, 110th minute.",
   "start": 20.55,
   "end": 22.58
  },
  {
   "text": "Italy win on penalties.",
   "start": 22.94,
   "end": 24.31
  },
  {
   "text": "And the next day, Zidane is still handed the Golden Ball as the best player of the tournament.",
   "start": 24.69,
   "end": 29.12
  }
 ]
