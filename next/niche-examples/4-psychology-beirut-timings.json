 "sentences": [
  {
   "text": "He splits eighteen boys into two teams, at a summer camp in Beirut.",
   "start": 0.0,
   "end": 3.56
  },
  {
   "text": "Ten are Christian.",
   "start": 3.89,
   "end": 4.91
  },
  {
   "text": "Eight are Muslim.",
   "start": 5.19,
   "end": 6.11
  },
  {
   "text": "So he mixes them.",
   "start": 6.48,
   "end": 7.36
  },
  {
   "text": "Five Christians and four Muslims on the Red Genies.",
   "start": 7.61,
   "end": 10.25
  },
  {
   "text": "Five and four on the Blue Ghost.",
   "start": 10.49,
   "end": 12.21
  },
  {
   "text": "He's repeating an American experiment.",
   "start": 12.54,
   "end": 14.39
  },
  {
   "text": "In Oklahoma, researchers posing as camp staff took twenty-two boys who'd never met, split them in two, and made the teams compete.",
   "start": 14.64,
   "end": 21.32
  },
  {
   "text": "The boys ended up enemies.",
   "start": 21.62,
   "end": 23.19
  },
  {
   "text": "But these boys arrive with a label the Oklahoma boys never had.",
   "start": 23.59,
   "end": 26.77
  },
  {
   "text": "So which line will they fight along?",
   "start": 27.1,
   "end": 28.5
  },
  {
   "text": "The competitions begin.",
   "start": 28.92,
   "end": 30.13
  },
  {
   "text": "Fighting breaks out.",
   "start": 30.38,
   "end": 31.45
  },
  {
   "text": "Not Christians against Muslims.",
   "start": 31.7,
   "end": 33.12
  },
  {
   "text": "Red against Blue.",
   "start": 33.41,
   "end": 34.63
  }
 ]
